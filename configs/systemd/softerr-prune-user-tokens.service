[Unit]
Description=Prune expired API account tokens
Requires=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -s /var/lib/softerr/backup-capture.lock /usr/sbin/runuser -u postgres -- /usr/bin/psql -X -v ON_ERROR_STOP=1 -d auth -f /etc/softerr/prune_user_tokens.sql
